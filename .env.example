# Critica configuration

# Required — Anthropic API key for Claude reasoning passes
ANTHROPIC_API_KEY=sk-ant-...

# Required — OpenAI API key for Whisper transcription
OPENAI_API_KEY=sk-...

# Required — Spreaker API key for episode metadata + audio fetch
# (also accepted as SPREAKER_TOKEN for parity with their docs)
SPREAKER_API_KEY=...
SPREAKER_USER_ID=...   # optional — needed only for list-by-user endpoints

# Required for /api/v1/review/megaphone — published episodes after the
# 2026-Q2 cutover live on Megaphone. Synced from /prod/shared/megaphone-api-token
# in cluster; org-wide token, Rails-style 'Token token="..."' auth.
MEGAPHONE_API_TOKEN=...
MEGAPHONE_BASE_URL=https://cms.megaphone.fm/api

# Required in prod — bearer tokens authorized to call /api/v1/*
# Comma-separated. Generate with: python -c "import secrets; print(f'ctc_{secrets.token_urlsafe(32)}')"
CRITICA_API_KEYS=ctc_example_replace_me

# Local dev only — fail open with no API keys configured
# CRITICA_DEV_MODE=true

# Service binding
HOST=0.0.0.0
PORT=8040
UVICORN_WORKERS=4

# Request limits
MAX_AUDIO_MB=500
REQUEST_TIMEOUT_S=600

# LLM defaults
CLAUDE_MODEL=claude-opus-4-5
CLAUDE_MAX_TOKENS=4096

# LLM backend: bedrock (default) | vertex | anthropic | openrouter
# Governs the Claude scoring pass only; media-gen (Nova/Titan/Stability) stays
# on Bedrock. Flip to 'vertex' per-env during the GKE cutover.
# LLM_BACKEND=vertex
# Vertex (Claude on GCP): auth via Workload Identity ADC, no key. Region us-east5.
# GOOGLE_CLOUD_PROJECT=ipointai-infra
# ANTHROPIC_VERTEX_REGION=us-east5
# VERTEX_MODEL=claude-opus-4-5@20251101   # defaults to the Vertex form of BEDROCK_MODEL

# Analytics-db connection (set in prod via SSM /prod/critica/analytics-db-url)
# ANALYTICS_DB_URL=postgresql://critica_writer:...@analytics-db-rw.prod.svc.cluster.local:5432/analytics?sslmode=require

# Temp file cleanup
QUALITAS_TMP_DIR=/tmp/critica
TMP_TTL_S=3600
